<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261114-0007" author="EvgenyZhulpa">
        <comment>Outcome documents header and lines</comment>
        <createTable tableName="outcome_documents">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="document_date" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="number" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="warehouse_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="outcome_documents" indexName="idx_outcome_documents_deleted">
            <column name="deleted"/>
        </createIndex>
        <createIndex tableName="outcome_documents" indexName="idx_outcome_documents_date_id">
            <column name="document_date"/>
            <column name="id"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableName="outcome_documents"
                baseColumnNames="warehouse_id"
                referencedTableName="warehouses"
                referencedColumnNames="id"
                constraintName="fk_outcome_documents_warehouse"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <createTable tableName="outcome_document_lines">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="outcome_document_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="product_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="NUMERIC(15, 3)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="outcome_document_lines"
                baseColumnNames="outcome_document_id"
                referencedTableName="outcome_documents"
                referencedColumnNames="id"
                constraintName="fk_outcome_document_lines_document"
                onDelete="CASCADE"
                onUpdate="RESTRICT"/>
        <addForeignKeyConstraint
                baseTableName="outcome_document_lines"
                baseColumnNames="product_id"
                referencedTableName="products"
                referencedColumnNames="id"
                constraintName="fk_outcome_document_lines_product"
                onDelete="RESTRICT"
                onUpdate="RESTRICT"/>

        <insert tableName="outcome_documents">
            <column name="document_date" valueComputed="CURRENT_TIMESTAMP"/>
            <column name="number" value="000001"/>
            <column name="warehouse_id" valueNumeric="1"/>
        </insert>
        <insert tableName="outcome_document_lines">
            <column name="outcome_document_id" valueNumeric="1"/>
            <column name="product_id" valueNumeric="1"/>
            <column name="quantity" valueNumeric="1"/>
        </insert>
    </changeSet>

    <changeSet id="20261114-0008" author="EvgenyZhulpa">
        <comment>Outcome document permissions</comment>
        <insert tableName="permissions">
            <column name="code" value="OUTCOME_DOCUMENTS_READ"/>
            <column name="name" value="Просмотр (чтение) реализаций товаров"/>
            <column name="system_defined" value="true"/>
        </insert>
        <insert tableName="permissions">
            <column name="code" value="OUTCOME_DOCUMENTS_WRITE"/>
            <column name="name" value="Добавление и изменение реализаций товаров"/>
            <column name="system_defined" value="true"/>
        </insert>
    </changeSet>

</databaseChangeLog>
